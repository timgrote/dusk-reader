#!/usr/bin/env python3
"""Serve the local Omarchy palette to the one allowed Dusk Reader extension."""

import json
import os
import re
import struct
import sys

PALETTE_PATH = os.path.join(
    os.environ.get("XDG_STATE_HOME", os.path.expanduser("~/.local/state")),
    "omarchy", "dusk-reader", "palette.json",
)
COLOR = re.compile(r"^#[0-9a-fA-F]{6}$")
REQUIRED = ("background", "foreground", "accent", "surface", "muted", "selection")


def send(message):
    data = json.dumps(message, separators=(",", ":")).encode("utf-8")
    sys.stdout.buffer.write(struct.pack("=I", len(data)))
    sys.stdout.buffer.write(data)
    sys.stdout.buffer.flush()


def read_request():
    header = sys.stdin.buffer.read(4)
    if len(header) != 4:
        return None
    size = struct.unpack("=I", header)[0]
    if size > 1024 * 1024:
        return None
    body = sys.stdin.buffer.read(size)
    try:
        return json.loads(body.decode("utf-8"))
    except (UnicodeDecodeError, json.JSONDecodeError):
        return None


def palette():
    try:
        with open(PALETTE_PATH, encoding="utf-8") as source:
            value = json.load(source)
    except (OSError, json.JSONDecodeError):
        return None
    colors = value.get("palette")
    if value.get("mode") not in ("light", "dark") or not isinstance(colors, dict):
        return None
    if not all(isinstance(colors.get(key), str) and COLOR.fullmatch(colors[key]) for key in REQUIRED):
        return None
    return {"mode": value["mode"], "palette": {key: colors[key] for key in REQUIRED}}


request = read_request()
if not isinstance(request, dict) or request.get("type") != "get-theme":
    send({"error": "unsupported request"})
else:
    value = palette()
    send(value if value else {"error": "palette unavailable"})
